      "owner": "customer",
      "prefix": "/internal/v1/customer",
      "routes": {
        "getProfile": {
          "method": "GET",
          "path": "/me",
          "access": "principal",
          "idempotent": false,
          "revisioned": false,
          "safe": false,
          "paged": false
        },
        "bootstrapProfile": {
          "method": "PUT",
          "path": "/me",
          "access": "principal",
          "idempotent": true,
          "revisioned": false,
          "safe": false,
          "paged": false
        },
        "updateProfile": {
          "method": "PATCH",
          "path": "/me",
          "access": "principal",
          "idempotent": true,
          "revisioned": true,
          "safe": false,
          "paged": false
        },
        "listAddresses": {
          "method": "GET",
          "path": "/me/addresses",
          "access": "principal",
          "idempotent": false,
          "revisioned": false,
          "safe": false,
          "paged": true
        },
        "createAddress": {
          "method": "POST",
          "path": "/me/addresses",
          "access": "principal",
          "idempotent": true,
          "revisioned": false,
          "safe": false,
          "paged": false
        },
        "updateAddress": {
          "method": "PATCH",
          "path": "/me/addresses/:addressId",
          "access": "principal",
          "idempotent": true,
          "revisioned": true,
          "safe": false,
          "paged": false
        },
        "archiveAddress": {
          "method": "POST",
          "path": "/me/addresses/:addressId/archive",
          "access": "principal",
          "idempotent": true,
          "revisioned": true,
          "safe": false,
          "paged": false
        },
        "resolveAddressSnapshot": {
          "method": "POST",
          "path": "/address-snapshots/resolve",
          "access": "service:customer.address-snapshot.resolve",
          "idempotent": false,
          "revisioned": false,
          "safe": true,
          "paged": false
        }
      },
      "reasons": [
        "ADDRESS_ARCHIVED",
        "ADDRESS_LIMIT_REACHED",
        "PROFILE_NOT_FOUND"
      ]
    },
