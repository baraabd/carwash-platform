{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./implementation-status.schema.json",
  "title": "WashGo implementation status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "asOf",
    "product",
    "foundation",
    "services",
    "applications",
    "governance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "mainSha"],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "mainSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readiness", "productionReady", "summary"],
      "properties": {
        "readiness": { "const": "foundation-accepted-product-not-implemented" },
        "productionReady": { "const": false },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "foundation": {
      "type": "object",
      "minProperties": 10,
      "maxProperties": 10,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "capability", "evidence"],
        "properties": {
          "status": { "const": "merged-and-verified" },
          "capability": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "runtimeImplementation",
          "database",
          "businessApi",
          "businessEvents",
          "deploymentVerified",
          "persistenceModels",
          "productDomainStatus"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^services/" },
          "runtimeImplementation": {
            "enum": [
              "existing-health-only-shell",
              "directory-and-typescript-skeleton-only"
            ]
          },
          "database": { "type": "string", "pattern": "^cw_" },
          "businessApi": { "const": "planned-not-implemented" },
          "businessEvents": { "const": "planned-not-implemented" },
          "deploymentVerified": { "const": false },
          "persistenceModels": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "productDomainStatus": {
            "enum": [
              "identity-security-foundation-only",
              "foundation-shell-only",
              "typescript-skeleton-only"
            ]
          }
        }
      }
    },
    "applications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customer-web", "operator-web", "admin-web", "api-gateway"],
      "properties": {
        "customer-web": { "$ref": "#/$defs/application" },
        "operator-web": { "$ref": "#/$defs/application" },
        "admin-web": { "$ref": "#/$defs/application" },
        "api-gateway": { "$ref": "#/$defs/application" }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branchProtection", "rulesets", "note"],
      "properties": {
        "branchProtection": { "enum": ["not-enforced", "enforced", "unknown"] },
        "rulesets": { "type": "integer", "minimum": 0 },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {
          "enum": [
            "golden-html-prototype-only",
            "planned-boundary-only",
            "foundation-gateway-runtime"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
