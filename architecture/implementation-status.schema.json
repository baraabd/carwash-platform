{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./implementation-status.schema.json",
  "title": "WashGo source-dated implementation inventory, not candidate runtime acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "asOf",
    "product",
    "foundation",
    "services",
    "runtimeInventory",
    "applications",
    "governance",
    "currentCandidateAcceptance",
    "verificationRecords"
  ],
  "properties": {
    "$schema": {
      "const": "./implementation-status.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "asOf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "mainSha", "scope"],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "mainSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "scope": {
          "const": "candidate-source-inventory"
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readiness", "productionReady", "summary"],
      "properties": {
        "readiness": {
          "const": "foundation-accepted-business-integration-pending"
        },
        "productionReady": {
          "const": false
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["F001", "F002", "F003", "F004", "F005", "F006", "F007", "F008", "F009", "F010"],
      "properties": {
        "F001": {
          "$ref": "#/$defs/foundation"
        },
        "F002": {
          "$ref": "#/$defs/foundation"
        },
        "F003": {
          "$ref": "#/$defs/foundation"
        },
        "F004": {
          "$ref": "#/$defs/foundation"
        },
        "F005": {
          "$ref": "#/$defs/foundation"
        },
        "F006": {
          "$ref": "#/$defs/foundation"
        },
        "F007": {
          "$ref": "#/$defs/foundation"
        },
        "F008": {
          "$ref": "#/$defs/foundation"
        },
        "F009": {
          "$ref": "#/$defs/foundation"
        },
        "F010": {
          "$ref": "#/$defs/foundation"
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "runtimeImplementation",
          "acceptedCapabilities",
          "database",
          "businessApi",
          "businessEvents",
          "deploymentVerified",
          "persistenceModels",
          "productDomainStatus",
          "runtimeAcceptance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^services/"
          },
          "runtimeImplementation": {
            "enum": [
              "existing-health-only-shell",
              "directory-and-typescript-skeleton-only",
              "onboarded-foundation-runtime",
              "implemented-capability-runtime"
            ]
          },
          "acceptedCapabilities": {
            "type": "array",
            "items": {
              "enum": ["identity-security-v1"]
            },
            "uniqueItems": true
          },
          "database": {
            "type": "string",
            "pattern": "^cw_"
          },
          "businessApi": {
            "const": "planned-not-implemented"
          },
          "businessEvents": {
            "const": "planned-not-implemented"
          },
          "deploymentVerified": {
            "const": false
          },
          "persistenceModels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "productDomainStatus": {
            "enum": [
              "identity-security-foundation-only",
              "foundation-shell-only",
              "typescript-skeleton-only"
            ]
          },
          "runtimeAcceptance": {
            "const": "not-verified-on-current-candidate"
          }
        }
      }
    },
    "runtimeInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "services",
        "runtimeServices",
        "foundationShells",
        "legacyFoundationShells",
        "onboardedFoundationShells",
        "capabilityRuntimes",
        "skeletons"
      ],
      "properties": {
        "services": {
          "type": "integer"
        },
        "runtimeServices": {
          "type": "integer"
        },
        "foundationShells": {
          "type": "integer"
        },
        "legacyFoundationShells": {
          "type": "integer"
        },
        "onboardedFoundationShells": {
          "type": "integer"
        },
        "capabilityRuntimes": {
          "type": "integer"
        },
        "skeletons": {
          "type": "integer"
        }
      }
    },
    "applications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customer-web", "operator-web", "admin-web", "api-gateway"],
      "properties": {
        "customer-web": {
          "$ref": "#/$defs/application"
        },
        "operator-web": {
          "$ref": "#/$defs/application"
        },
        "admin-web": {
          "$ref": "#/$defs/application"
        },
        "api-gateway": {
          "$ref": "#/$defs/application"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branchProtection", "rulesets", "note", "observedAt"],
      "properties": {
        "branchProtection": {
          "enum": ["not-enforced", "enforced", "unknown"]
        },
        "rulesets": {
          "type": "integer"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "observedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "currentCandidateAcceptance": {
      "const": "not-verified-on-current-candidate"
    },
    "verificationRecords": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foundation-2026-10-01"],
      "properties": {
        "foundation-2026-10-01": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "sourceSha",
            "scope",
            "appliesToCurrentCandidate",
            "evidence",
            "note"
          ],
          "properties": {
            "date": {
              "const": "2026-10-01"
            },
            "sourceSha": {
              "const": "f364792d78cf572444df8093c2e4c6315becdae9"
            },
            "scope": {
              "const": "historical-F001-F010-foundation"
            },
            "appliesToCurrentCandidate": {
              "const": false
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "capability", "evidence", "verificationRecord"],
      "properties": {
        "status": {
          "const": "merged-and-verified"
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verificationRecord": {
          "const": "foundation-2026-10-01"
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence",
        "businessIntegration",
        "productionReady",
        "currentCandidateAcceptance"
      ],
      "properties": {
        "status": {
          "enum": [
            "react-session-demo-partially-implemented",
            "technical-boot-shell-only",
            "foundation-gateway-runtime"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "businessIntegration": {
          "const": "not-implemented"
        },
        "productionReady": {
          "const": false
        },
        "currentCandidateAcceptance": {
          "const": "not-verified-on-current-candidate"
        }
      }
    }
  }
}
