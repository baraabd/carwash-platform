{
  "name": "carwash-platform",
  "private": true,
  "type": "module",
  "version": "0.0.2",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.32.1 <11"
  },
  "scripts": {
    "resolve:dependencies": "node scripts/resolve-dependencies.mjs",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "verify:toolchain:config": "node scripts/verify-toolchain.mjs --config-only",
    "verify:frozen-install": "node scripts/verify-frozen-install.mjs",
    "verify:lockfile": "node scripts/verify-frozen-install.mjs --audit-only",
    "generate": "pnpm --filter \"./services/*\" --sequential run generate",
    "build": "pnpm run build:domain && pnpm run build:packages && pnpm --filter \"./services/*\" --sequential run build && pnpm --filter @carwash/api-gateway run build && pnpm run build:apps",
    "build:tests": "pnpm --filter \"./services/*\" --sequential run build:tests",
    "build:domain": "pnpm --filter @carwash/contracts run build && tsc -p tsconfig.domain.json",
    "typecheck": "pnpm --filter \"./packages/*\" --sequential run typecheck && pnpm --filter \"./services/*\" --sequential run typecheck && pnpm --filter @carwash/api-gateway run typecheck && pnpm run typecheck:apps",
    "lint": "pnpm run build:packages && pnpm generate && eslint .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "check:boundaries": "node scripts/check-boundaries.mjs && node scripts/check-layers.mjs && node scripts/dev/generate-service-shells.mjs --check",
    "check:layers": "node scripts/check-layers.mjs",
    "check:design-reference": "node scripts/check-design-reference.mjs",
    "test:domain": "node --test --test-reporter=tap tests/*.test.mjs",
    "test:unit": "node --test --test-reporter=spec tests/unit/*.test.mjs tests/*.test.mjs",
    "test:nest": "node scripts/run-nest-tests.mjs",
    "test:design-lock": "node --test --test-reporter=tap tests/design/reference-lock.test.mjs",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "acceptance:preflight": "node scripts/acceptance.mjs --preflight",
    "acceptance:run": "node scripts/acceptance.mjs --run",
    "verify:release": "node scripts/acceptance.mjs --run",
    "verify:foundation": "pnpm verify:toolchain && pnpm check:boundaries && pnpm check:migrations && pnpm build:domain && pnpm test:domain",
    "dev:env": "node scripts/create-dev-env.mjs",
    "infra:up": "docker compose --env-file .env.local -f infra/compose.dev.yml up -d",
    "infra:down": "docker compose --env-file .env.local -f infra/compose.dev.yml down",
    "prototype": "node scripts/serve-prototype.mjs",
    "build:packages": "pnpm --filter \"./packages/*\" --sequential run build",
    "build:ownership": "tsc -p tsconfig.ownership.json",
    "typecheck:ownership": "tsc -p tsconfig.ownership.json --noEmit",
    "check:ownership": "pnpm build:ownership && node scripts/check-ownership.mjs",
    "check:ownership:ci": "pnpm build:ownership && node scripts/check-ownership.mjs --ci --json",
    "test:ownership": "pnpm build:ownership && node --test --test-reporter=tap tests/ownership/checker.test.mjs tests/ownership/references.test.mjs",
    "check:foundation": "pnpm build:ownership && node scripts/check-foundation.mjs",
    "check:foundation:ci": "pnpm build:ownership && node scripts/check-foundation.mjs --ci",
    "test:f001": "pnpm build:ownership && node scripts/f001/test.mjs",
    "lint:f001": "node scripts/f001/quality.mjs lint",
    "format:f001:check": "node scripts/f001/quality.mjs format-check",
    "format:f001:write": "node scripts/f001/quality.mjs format-write",
    "build:workspace": "pnpm generate && turbo run build",
    "verify:f001": "node scripts/f001/acceptance.mjs",
    "test:contracts": "node --test --test-reporter=tap tests/contracts/public-event-contract.test.mjs",
    "test:production:e": "node --test --test-reporter=spec \"tests/production/E/*.test.mjs\"",
    "check:contract-docs": "node scripts/production/E/contract-docs.mjs",
    "check:contract-surface": "node scripts/production/E/contract-surface.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "acceptance:identity": "node scripts/acceptance-identity.mjs",
    "test:gateway": "node --test tests/gateway/unit.test.mjs",
    "acceptance:gateway": "node scripts/acceptance-identity.mjs --include-gateway",
    "check:gateway-contract": "node scripts/gateway-openapi.mjs --check",
    "test:observability": "node --test --test-reporter=spec tests/observability/*.test.mjs",
    "check:f010-references": "node scripts/f010/reference-registry.mjs --allow-registration",
    "test:f010:unit": "node --test --test-reporter=spec tests/f010/*.test.mjs",
    "test:f010:browser": "node scripts/f010/browser-acceptance.mjs",
    "f010:fonts": "node scripts/f010/font-provenance.mjs",
    "verify:f010": "pnpm check:design-reference && pnpm check:f010-references && pnpm test:f010:unit && pnpm test:f010:browser",
    "typecheck:apps": "pnpm --filter \"./apps/*-web\" --sequential run typecheck",
    "build:apps": "pnpm --filter \"./apps/*-web\" --sequential run build",
    "test:production:e": "node --test --test-reporter=spec \"tests/production/E/*.test.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "turbo": "2.11.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "pnpm": {
    "overrides": {
      "multer": "2.4.0",
      "mysql2": ">=3.23.1",
      "deepmerge-ts": ">=8.0.0",
      "@nestjs/platform-express>multer": "2.4.0"
    }
  }
}
