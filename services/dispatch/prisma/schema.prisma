// dispatch owns this schema.
//
// Generated by scripts/dev/generate-service-schemas.mjs and then committed.
// No other service may read, write or import these tables, and this file must
// never describe another service's data. There is no shared business schema.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// The connection URL lives in prisma.config.ts / the environment, never here, so
// the migration identity and the runtime identity stay genuinely separate.
datasource db {
  provider = "postgresql"
}

/// Written by the migration job so a test can prove migrations really ran
/// against this database rather than assuming they did.
model ServiceMarker {
  service   String   @id
  schemaRev Int      @map("schema_rev")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("service_marker")
}

/// Highest Scheduling hold revision applied per hold (scheduling.hold-changed.v1).
/// Events at or below it are stale and ignored.
model HoldObservation {
  holdId    String   @id @map("hold_id") @db.Uuid
  version   Int
  state     String
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("hold_observation")
}

/// One job per booking. The resource CHECK and the exclusion constraint that
/// forbids overlapping ASSIGNED jobs per resource live in the migration SQL.
model Assignment {
  id                String          @id @db.Uuid
  bookingId         String          @unique @map("booking_id") @db.Uuid
  holdId            String          @unique @map("hold_id") @db.Uuid
  zoneId            String          @map("zone_id") @db.Uuid
  startsAt          DateTime        @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime        @map("ends_at") @db.Timestamptz(3)
  status            String
  resourceId        String?         @map("resource_id") @db.Uuid
  technicianSubject String?         @map("technician_subject") @db.Uuid
  cancelReason      String?         @map("cancel_reason")
  pendingChangeId   String?         @map("pending_change_id") @db.Uuid
  version           Int             @default(1)
  createdAt         DateTime        @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @map("updated_at") @db.Timestamptz(3)
  offers            DispatchOffer[]
  tasks             Task[]
  bookingChanges    BookingChange[]

  @@index([zoneId, startsAt])
  @@map("assignment")
}

/// Offer of a job to one workforce resource. The partial unique indexes (one
/// OFFERED and one ACCEPTED offer per assignment) live in the migration SQL.
model DispatchOffer {
  id                String     @id @db.Uuid
  assignmentId      String     @map("assignment_id") @db.Uuid
  resourceId        String     @map("resource_id") @db.Uuid
  technicianSubject String     @map("technician_subject") @db.Uuid
  status            String
  expiresAt         DateTime   @map("expires_at") @db.Timestamptz(3)
  declineReason     String?    @map("decline_reason")
  withdrawReason    String?    @map("withdraw_reason")
  declineNote       String?    @map("decline_note") @db.VarChar(500)
  createdBy         String     @map("created_by") @db.VarChar(80)
  version           Int        @default(1)
  createdAt         DateTime   @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @map("updated_at") @db.Timestamptz(3)
  assignment        Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  task              Task?

  @@index([assignmentId])
  @@index([technicianSubject, status])
  @@index([resourceId, status])
  @@index([status, expiresAt])
  @@map("dispatch_offer")
}

/// Completed idempotent commands, kept for the documented retention window.
model IdempotencyRecord {
  scope              String   @db.VarChar(200)
  idempotencyKey     String   @map("idempotency_key") @db.VarChar(128)
  requestFingerprint String   @map("request_fingerprint") @db.Char(64)
  resultType         String   @map("result_type")
  resultId           String   @map("result_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([scope, idempotencyKey])
  @@index([createdAt])
  @@map("idempotency_record")
}

/// Consumed events; the row and the local effect commit in one transaction.
model InboxMessage {
  eventId       String   @id @map("event_id") @db.Uuid
  eventType     String   @map("event_type")
  payloadHash   String   @map("payload_hash") @db.Char(64)
  correlationId String   @map("correlation_id") @db.Uuid
  outcome       String?  @db.VarChar(32)
  receivedAt    DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@map("inbox_message")
}

/// Transactional outbox, same lease semantics as the catalog relay store.
model OutboxMessage {
  id            String    @id @db.Uuid
  eventId       String    @unique @map("event_id") @db.Uuid
  eventType     String    @map("event_type")
  exchange      String
  routingKey    String    @map("routing_key")
  payload       String
  correlationId String    @map("correlation_id") @db.Uuid
  traceParent   String?   @map("trace_parent") @db.VarChar(55)
  attempts      Int       @default(0)
  lockedBy      String?   @map("locked_by")
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(3)
  lastError     String?   @map("last_error")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  deadAt        DateTime? @map("dead_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([publishedAt, deadAt, createdAt], map: "outbox_message_pending_idx")
  @@map("outbox_message")
}

/// Append-only audit of sensitive mutations. Opaque identifiers only.
model AuditEntry {
  id            String   @id @db.Uuid
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorKind     String   @map("actor_kind")
  actorId       String   @map("actor_id") @db.VarChar(80)
  action        String   @db.VarChar(64)
  targetType    String   @map("target_type") @db.VarChar(32)
  targetId      String   @map("target_id") @db.Uuid
  correlationId String   @map("correlation_id") @db.Uuid
  details       Json

  @@index([targetType, targetId])
  @@map("audit_entry")
}

/// Highest workforce.eligibility-changed.v1 revision applied per resource.
model ResourceObservation {
  resourceId  String   @id @map("resource_id") @db.Uuid
  eligibility String
  revision    Int
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("resource_observation")
}

/// Execution of an accepted job by its technician. Stage machine, gates, the
/// partial unique indexes and the immutability triggers live in the migration SQL.
model Task {
  id                    String         @id @db.Uuid
  assignmentId          String         @map("assignment_id") @db.Uuid
  offerId               String         @unique @map("offer_id") @db.Uuid
  bookingId             String         @map("booking_id") @db.Uuid
  resourceId            String         @map("resource_id") @db.Uuid
  technicianSubject     String         @map("technician_subject") @db.Uuid
  stage                 String
  checklistVersion      String         @map("checklist_version") @db.VarChar(40)
  checklist             Json
  conditionNote         String?        @map("condition_note") @db.VarChar(800)
  acceptedAt            DateTime       @map("accepted_at") @db.Timestamptz(3)
  departedAt            DateTime?      @map("departed_at") @db.Timestamptz(3)
  arrivedAt             DateTime?      @map("arrived_at") @db.Timestamptz(3)
  arrivalMethod         String?        @map("arrival_method")
  startedAt             DateTime?      @map("started_at") @db.Timestamptz(3)
  documentedAt          DateTime?      @map("documented_at") @db.Timestamptz(3)
  finishedAt            DateTime?      @map("finished_at") @db.Timestamptz(3)
  closedAt              DateTime?      @map("closed_at") @db.Timestamptz(3)
  endedAt               DateTime?      @map("ended_at") @db.Timestamptz(3)
  endReason             String?        @map("end_reason")
  releaseReason         String?        @map("release_reason") @db.VarChar(500)
  attentionReason       String?        @map("attention_reason")
  collectionOutcome     String?        @map("collection_outcome")
  collectionCurrency    String?        @map("collection_currency") @db.Char(3)
  collectionScale       Int?           @map("collection_scale") @db.SmallInt
  collectionAmountMinor BigInt?        @map("collection_amount_minor")
  collectionReason      String?        @map("collection_reason") @db.VarChar(500)
  collectionDeclaredAt  DateTime?      @map("collection_declared_at") @db.Timestamptz(3)
  lateAmountMinor       BigInt?        @map("late_amount_minor")
  lateDeclaredAt        DateTime?      @map("late_declared_at") @db.Timestamptz(3)
  version               Int            @default(1)
  createdAt             DateTime       @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @map("updated_at") @db.Timestamptz(3)
  assignment            Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  offer                 DispatchOffer  @relation(fields: [offerId], references: [id], onDelete: Restrict)
  evidence              TaskEvidence[]
  notes                 TaskNote[]
  events                TaskEvent[]

  @@index([assignmentId])
  @@index([technicianSubject, updatedAt])
  @@index([resourceId, stage])
  @@map("task")
}

/// Link of a Media object to a task photo slot. Append-only except removal.
model TaskEvidence {
  id            String    @id @db.Uuid
  taskId        String    @map("task_id") @db.Uuid
  phase         String
  slot          Int       @db.SmallInt
  mediaObjectId String    @unique @map("media_object_id") @db.Uuid
  attachedAt    DateTime  @map("attached_at") @db.Timestamptz(3)
  removedAt     DateTime? @map("removed_at") @db.Timestamptz(3)
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@map("task_evidence")
}

/// Technician notes (help, cash issue, payment follow-up). Append-only.
model TaskNote {
  id        String   @id @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  kind      String
  text      String   @db.VarChar(500)
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@map("task_note")
}

/// Ordered task history shown to the technician. Append-only.
model TaskEvent {
  id         String   @id @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  seq        Int
  action     String   @db.VarChar(40)
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([taskId, seq])
  @@map("task_event")
}

/// A change Booking asked Dispatch to apply to a booking's job (P04-C2):
/// a cancellation (or its tombstone) or a rebind to a new slot. The partial
/// unique indexes (one cancellation and one pending rebind per booking) and
/// the shape CHECKs live in the migration SQL.
model BookingChange {
  changeId     String      @id @map("change_id") @db.Uuid
  bookingId    String      @map("booking_id") @db.Uuid
  kind         String
  state        String
  assignmentId String?     @map("assignment_id") @db.Uuid
  fromHoldId   String?     @map("from_hold_id") @db.Uuid
  fromStartsAt DateTime?   @map("from_starts_at") @db.Timestamptz(3)
  fromEndsAt   DateTime?   @map("from_ends_at") @db.Timestamptz(3)
  toHoldId     String?     @map("to_hold_id") @db.Uuid
  toStartsAt   DateTime?   @map("to_starts_at") @db.Timestamptz(3)
  toEndsAt     DateTime?   @map("to_ends_at") @db.Timestamptz(3)
  createdAt    DateTime    @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @map("updated_at") @db.Timestamptz(3)
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([bookingId])
  @@map("booking_change")
}
