// configuration owns this schema.
//
// Generated by scripts/dev/generate-service-schemas.mjs and then committed.
// No other service may read, write or import these tables, and this file must
// never describe another service's data. There is no shared business schema.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// The connection URL lives in prisma.config.ts / the environment, never here, so
// the migration identity and the runtime identity stay genuinely separate.
datasource db {
  provider = "postgresql"
}

/// Written by the migration job so a test can prove migrations really ran
/// against this database rather than assuming they did.
model ServiceMarker {
  service   String   @id
  schemaRev Int      @map("schema_rev")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("service_marker")
}

/// P01-D configuration revisions. Append-only: a value is never edited in
/// place, every change is a new revision with author, reason and a value hash.
/// (author_subject, idempotency_key) makes a retried proposal replay instead of
/// creating a second revision.
model ConfigRevision {
  id             String   @id @db.Uuid
  namespace      String   @db.VarChar(32)
  key            String   @db.VarChar(64)
  environment    String   @db.VarChar(16)
  tenantScope    String   @map("tenant_scope") @db.VarChar(36)
  revision       Int
  valueType      String   @map("value_type") @db.VarChar(16)
  value          Json
  valueHash      String   @map("value_hash") @db.Char(64)
  requestHash    String   @map("request_hash") @db.Char(64)
  authorSubject  String   @map("author_subject") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  reason         String   @db.VarChar(500)
  proposedAt     DateTime @map("proposed_at") @db.Timestamptz(3)

  review ConfigReview?

  @@unique([namespace, key, environment, tenantScope, revision])
  @@unique([authorSubject, idempotencyKey])
  @@map("config_revision")
}

/// At most one review decision per revision (the primary key), recorded by a
/// different person than the author (enforced by the application and audited).
model ConfigReview {
  revisionId      String         @id @map("revision_id") @db.Uuid
  decision        String         @db.VarChar(10)
  reviewerSubject String         @map("reviewer_subject") @db.Uuid
  note            String         @db.VarChar(500)
  reviewedAt      DateTime       @map("reviewed_at") @db.Timestamptz(3)
  revision        ConfigRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@map("config_review")
}

/// Which approved revision is active for a scope. version is the optimistic
/// concurrency token callers must present to move it.
model ConfigPointer {
  namespace        String   @db.VarChar(32)
  key              String   @db.VarChar(64)
  environment      String   @db.VarChar(16)
  tenantScope      String   @map("tenant_scope") @db.VarChar(36)
  activeRevisionId String   @map("active_revision_id") @db.Uuid
  activeRevision   Int      @map("active_revision")
  version          Int
  updatedBy        String   @map("updated_by") @db.Uuid
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(3)

  @@id([namespace, key, environment, tenantScope])
  @@map("config_pointer")
}

/// Append-only audit of every sensitive configuration command. It holds
/// identifiers and hashes, never the configuration value itself.
model ConfigAudit {
  id            String   @id @db.Uuid
  action        String   @db.VarChar(24)
  actorSubject  String   @map("actor_subject") @db.Uuid
  revisionId    String   @map("revision_id") @db.Uuid
  scopeKey      String   @map("scope_key") @db.VarChar(160)
  valueHash     String   @map("value_hash") @db.Char(64)
  correlationId String   @map("correlation_id") @db.VarChar(64)
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(3)

  @@index([revisionId])
  @@map("config_audit")
}

/// P05-D5 configuration.v1 scope: one per (market, namespace). `id` is the
/// event aggregate id; publishedVersion moves forward by exactly one (trigger).
model ConfigScope {
  id               String   @id @db.Uuid
  marketId         String   @map("market_id") @db.VarChar(11)
  namespace        String   @db.VarChar(32)
  publishedVersion Int      @default(0) @map("published_version")
  createdAt        DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(3)

  drafts   ConfigDraft[]
  versions ConfigVersion[]
  history  ConfigHistory[]

  @@unique([marketId, namespace])
  @@map("config_scope")
}

/// A proposed content for a scope. At most one DRAFT/APPROVED draft per scope
/// (partial unique index in the migration). Four eyes is a CHECK constraint.
model ConfigDraft {
  id               String    @id @db.Uuid
  scopeId          String    @map("scope_id") @db.Uuid
  revision         Int
  status           String    @db.VarChar(10)
  baseVersion      Int?      @map("base_version")
  content          Json
  contentHash      String    @map("content_hash") @db.Char(64)
  authorSubject    String    @map("author_subject") @db.Uuid
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  approvedBy       String?   @map("approved_by") @db.Uuid
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz(3)
  publishedBy      String?   @map("published_by") @db.Uuid
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(3)
  publishedVersion Int?      @map("published_version")
  withdrawnBy      String?   @map("withdrawn_by") @db.Uuid
  withdrawnAt      DateTime? @map("withdrawn_at") @db.Timestamptz(3)
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)

  scope   ConfigScope    @relation(fields: [scopeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  version ConfigVersion?

  @@index([scopeId, createdAt])
  @@map("config_draft")
}

/// An immutable published version (append-only by trigger).
model ConfigVersion {
  id          String   @id @db.Uuid
  scopeId     String   @map("scope_id") @db.Uuid
  version     Int
  draftId     String   @unique @map("draft_id") @db.Uuid
  content     Json
  contentHash String   @map("content_hash") @db.Char(64)
  effectiveAt DateTime @map("effective_at") @db.Timestamptz(3)
  publishedBy String   @map("published_by") @db.Uuid
  publishedAt DateTime @map("published_at") @db.Timestamptz(3)

  scope ConfigScope @relation(fields: [scopeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  draft ConfigDraft @relation(fields: [draftId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([scopeId, version])
  @@map("config_version")
}

/// Append-only history of every draft/approve/publish/withdraw command.
model ConfigHistory {
  id            String   @id @db.Uuid
  scopeId       String   @map("scope_id") @db.Uuid
  draftId       String   @map("draft_id") @db.Uuid
  action        String   @db.VarChar(16)
  draftRevision Int      @map("draft_revision")
  version       Int?
  contentHash   String   @map("content_hash") @db.Char(64)
  actorSubject  String   @map("actor_subject") @db.Uuid
  reason        String?  @db.VarChar(500)
  correlationId String   @map("correlation_id") @db.VarChar(64)
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(3)
  /// Insertion order, the stable paging cursor of the history.
  seq           BigInt   @unique @default(autoincrement())

  scope ConfigScope @relation(fields: [scopeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([scopeId, seq])
  @@map("config_history")
}

/// Replayable outcome of an idempotent configuration.v1 command, written in
/// the command's own transaction. Append-only by trigger.
model ConfigIdempotency {
  actorSubject   String   @map("actor_subject") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  operation      String   @db.VarChar(32)
  fingerprint    String   @db.Char(64)
  statusCode     Int      @map("status_code")
  response       Json
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)

  @@id([actorSubject, idempotencyKey])
  @@map("config_idempotency")
}

/// Transactional outbox, leased by the shared OutboxRelay (same shape and
/// lease semantics as the catalog/booking stores).
model OutboxMessage {
  id            String    @id @db.Uuid
  eventId       String    @unique @map("event_id") @db.Uuid
  eventType     String    @map("event_type")
  exchange      String
  routingKey    String    @map("routing_key")
  payload       String
  correlationId String    @map("correlation_id") @db.Uuid
  traceParent   String?   @map("trace_parent") @db.VarChar(55)
  attempts      Int       @default(0)
  lockedBy      String?   @map("locked_by")
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(3)
  lastError     String?   @map("last_error")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  deadAt        DateTime? @map("dead_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([publishedAt, deadAt, createdAt])
  @@map("outbox_message")
}
