// workforce owns this schema.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model ServiceMarker {
  service   String   @id
  schemaRev Int      @map("schema_rev")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("service_marker")
}

model Operator {
  id                 String             @id @db.Uuid
  identitySubject    String             @unique @map("identity_subject") @db.Uuid
  displayName        String             @map("display_name") @db.VarChar(80)
  homeZoneId         String             @map("home_zone_id") @db.Uuid
  employmentStatus   String             @default("ACTIVE") @map("employment_status")
  suspensionReason   String?            @map("suspension_reason")
  verificationStatus String             @default("UNVERIFIED") @map("verification_status")
  verifiedUntil      DateTime?          @map("verified_until") @db.Timestamptz(3)
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @default(now()) @map("updated_at") @db.Timestamptz(3)
  grants             WorkGrant[]
  cases              VerificationCase[]
  shifts             WorkShift[]

  @@map("operator")
}

model WorkGrant {
  id         String   @id @db.Uuid
  operatorId String   @map("operator_id") @db.Uuid
  skillCode  String   @map("skill_code") @db.VarChar(40)
  grantedBy  String   @map("granted_by") @db.Uuid
  grantedAt  DateTime @map("granted_at") @db.Timestamptz(3)
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  @@unique([operatorId, skillCode])
  @@index([skillCode])
  @@map("work_grant")
}

model VerificationCase {
  id                 String    @id @db.Uuid
  operatorId         String    @map("operator_id") @db.Uuid
  pendingOperatorId  String?   @unique @map("pending_operator_id") @db.Uuid
  status             String
  evidenceRefs       String[]  @map("evidence_refs") @db.Uuid
  submittedBy        String    @map("submitted_by") @db.Uuid
  submittedAt        DateTime  @map("submitted_at") @db.Timestamptz(3)
  decidedBy          String?   @map("decided_by") @db.Uuid
  decidedAt          DateTime? @map("decided_at") @db.Timestamptz(3)
  decisionReason     String?   @map("decision_reason")
  validUntil         DateTime? @map("valid_until") @db.Timestamptz(3)
  requester          String    @db.VarChar(120)
  idempotencyKey     String    @map("idempotency_key") @db.VarChar(128)
  requestFingerprint String    @map("request_fingerprint") @db.Char(64)
  version            Int       @default(1)
  operator           Operator  @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  @@unique([requester, idempotencyKey])
  @@index([operatorId])
  @@index([status, submittedAt])
  @@map("verification_case")
}

model WorkShift {
  id                 String   @id @db.Uuid
  operatorId         String   @map("operator_id") @db.Uuid
  zoneId             String   @map("zone_id") @db.Uuid
  startsAt           DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime @map("ends_at") @db.Timestamptz(3)
  status             String   @default("ACTIVE")
  requester          String   @db.VarChar(120)
  idempotencyKey     String   @map("idempotency_key") @db.VarChar(128)
  requestFingerprint String   @map("request_fingerprint") @db.Char(64)
  version            Int      @default(1)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  operator           Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  @@unique([requester, idempotencyKey])
  @@index([operatorId, startsAt])
  @@index([zoneId, status, startsAt])
  @@map("work_shift")
}

model OutboxMessage {
  id            String    @id @db.Uuid
  eventId       String    @unique @map("event_id") @db.Uuid
  eventType     String    @map("event_type")
  exchange      String
  routingKey    String    @map("routing_key")
  payload       String
  correlationId String    @map("correlation_id") @db.Uuid
  traceParent   String?   @map("trace_parent") @db.VarChar(55)
  attempts      Int       @default(0)
  lockedBy      String?   @map("locked_by")
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(3)
  lastError     String?   @map("last_error")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  deadAt        DateTime? @map("dead_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([publishedAt, deadAt, createdAt], map: "outbox_message_pending_idx")
  @@map("outbox_message")
}

model AuditEntry {
  id            String   @id @db.Uuid
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorKind     String   @map("actor_kind")
  actorId       String   @map("actor_id") @db.VarChar(80)
  action        String   @db.VarChar(64)
  targetType    String   @map("target_type") @db.VarChar(32)
  targetId      String   @map("target_id") @db.Uuid
  correlationId String   @map("correlation_id") @db.Uuid
  details       Json

  @@index([targetType, targetId])
  @@map("audit_entry")
}
