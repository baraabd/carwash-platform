// pricing owns this schema.
//
// Generated by scripts/dev/generate-service-schemas.mjs and then committed.
// No other service may read, write or import these tables, and this file must
// never describe another service's data. There is no shared business schema.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// The connection URL lives in prisma.config.ts / the environment, never here, so
// the migration identity and the runtime identity stay genuinely separate.
datasource db {
  provider = "postgresql"
}

/// Written by the migration job so a test can prove migrations really ran
/// against this database rather than assuming they did.
model ServiceMarker {
  service   String   @id
  schemaRev Int      @map("schema_rev")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("service_marker")
}

/// Singleton row locked FOR UPDATE by every price publisher.
model PricingPublicationLock {
  id Int @id @db.SmallInt

  @@map("pricing_publication_lock")
}

/// DEPRECATED (P01-B2 pre-contract model; no writes since P06-B2).
/// One immutable price version for one exact catalog revision. Versions form a
/// linear chain with strictly increasing effective_from (non-overlapping
/// windows). catalog_snapshot is Pricing's own immutable copy of the catalog
/// view the rates were validated against (obtained from the Catalog owner API).
model PriceVersion {
  version            Int           @id
  previousVersion    Int?          @unique @map("previous_version")
  effectiveFrom      DateTime      @unique @map("effective_from") @db.Timestamptz(3)
  publishedAt        DateTime      @map("published_at") @db.Timestamptz(3)
  publishedBy        String        @map("published_by") @db.Uuid
  correlationId      String        @map("correlation_id") @db.Uuid
  catalogRevision    Int           @map("catalog_revision")
  catalogFingerprint String        @map("catalog_fingerprint") @db.Char(64)
  catalogSnapshot    Json          @map("catalog_snapshot")
  policyRevision     String        @map("policy_revision") @db.VarChar(64)
  currency           String        @db.Char(3)
  minorUnitExponent  Int           @map("minor_unit_exponent") @db.SmallInt
  ratesFingerprint   String        @map("rates_fingerprint") @db.Char(64)
  previous           PriceVersion? @relation("PriceVersionChain", fields: [previousVersion], references: [version], onDelete: Restrict, onUpdate: Restrict)
  next               PriceVersion? @relation("PriceVersionChain")
  rates              PriceRate[]
  quotes             Quote[]

  @@map("price_version")
}

model PriceRate {
  version      Int
  kind         String       @db.VarChar(8)
  definitionId String       @map("definition_id") @db.VarChar(48)
  amountMinor  BigInt       @map("amount_minor")
  priceVersion PriceVersion @relation(fields: [version], references: [version], onDelete: Restrict, onUpdate: Restrict)

  @@id([version, kind, definitionId])
  @@map("price_rate")
}

/// DEPRECATED (P01-B2 pre-contract model; no writes since P06-B2).
/// Immutable server-issued quote. Owner is the verified Identity subject.
model Quote {
  id                String       @id @db.Uuid
  ownerSubject      String       @map("owner_subject") @db.Uuid
  priceVersion      Int          @map("price_version")
  catalogRevision   Int          @map("catalog_revision")
  policyRevision    String       @map("policy_revision") @db.VarChar(64)
  currency          String       @db.Char(3)
  minorUnitExponent Int          @map("minor_unit_exponent") @db.SmallInt
  categoryId        String       @map("category_id") @db.VarChar(48)
  packageId         String       @map("package_id") @db.VarChar(48)
  addonIds          String[]     @map("addon_ids")
  subtotalMinor     BigInt       @map("subtotal_minor")
  totalMinor        BigInt       @map("total_minor")
  durationMinutes   Int          @map("duration_minutes")
  inputFingerprint  String       @map("input_fingerprint") @db.Char(64)
  issuedAt          DateTime     @map("issued_at") @db.Timestamptz(3)
  expiresAt         DateTime     @map("expires_at") @db.Timestamptz(3)
  correlationId     String       @map("correlation_id") @db.Uuid
  version           PriceVersion @relation(fields: [priceVersion], references: [version], onDelete: Restrict, onUpdate: Restrict)
  lines             QuoteLine[]
  discount          QuoteDiscount?

  @@index([ownerSubject, issuedAt], map: "quote_owner_issued_idx")
  @@map("quote")
}

model QuoteLine {
  quoteId      String  @map("quote_id") @db.Uuid
  lineNo       Int     @map("line_no") @db.SmallInt
  kind         String  @db.VarChar(8)
  definitionId String  @map("definition_id") @db.VarChar(48)
  amountMinor  BigInt  @map("amount_minor")
  included     Boolean
  quote        Quote   @relation(fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([quoteId, lineNo])
  @@map("quote_line")
}

/// Durable terminal outcome of an idempotent command, scoped to actor+operation.
model PricingIdempotencyReceipt {
  actorSubject       String   @map("actor_subject") @db.Uuid
  operation          String   @db.VarChar(64)
  idempotencyKey     String   @map("idempotency_key") @db.VarChar(128)
  requestFingerprint String   @map("request_fingerprint") @db.Char(64)
  responseStatus     Int      @map("response_status")
  responseBody       Json     @map("response_body")
  createdAt          DateTime @map("created_at") @db.Timestamptz(3)

  @@id([actorSubject, operation, idempotencyKey])
  @@map("pricing_idempotency_receipt")
}

/// Append-only audit of price publication.
model PricingAuditEvent {
  id            String   @id @db.Uuid
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(3)
  actorSubject  String   @map("actor_subject") @db.Uuid
  action        String   @db.VarChar(64)
  version       Int?
  outcome       String   @db.VarChar(64)
  correlationId String   @map("correlation_id") @db.Uuid

  @@index([occurredAt], map: "pricing_audit_event_occurred_idx")
  @@map("pricing_audit_event")
}

// ---------------------------------------------------------------------------
// pricing.v1 (P06-B2). The P01-B2 models above are deprecated: kept for
// expand/contract compatibility, never written by this release.
// ---------------------------------------------------------------------------

/// One immutable, complete price book for the Catalog view stored with it.
/// Revisions form a linear chain; the newest committed revision is in force.
model PriceBook {
  revision           Int              @id
  previousRevision   Int?             @unique @map("previous_revision")
  currency           String           @db.Char(3)
  scale              Int              @db.SmallInt
  policyRevision     String           @map("policy_revision") @db.VarChar(64)
  catalogRevision    Int              @map("catalog_revision")
  catalogFingerprint String           @map("catalog_fingerprint") @db.Char(64)
  catalogView        Json             @map("catalog_view")
  entriesFingerprint String           @map("entries_fingerprint") @db.Char(64)
  publishedAt        DateTime         @map("published_at") @db.Timestamptz(3)
  publishedBy        String           @map("published_by") @db.Uuid
  correlationId      String           @map("correlation_id") @db.Uuid
  previous           PriceBook?       @relation("PriceBookChain", fields: [previousRevision], references: [revision], onDelete: Restrict, onUpdate: Restrict)
  next               PriceBook?       @relation("PriceBookChain")
  entries            PriceBookEntry[]
  quotes             PricingQuote[]

  @@map("price_book")
}

/// vehicleScope '*' is the pricing.v1 `vehicleType: null` entry.
model PriceBookEntry {
  revision       Int
  definitionId   String    @map("definition_id") @db.Uuid
  vehicleScope   String    @map("vehicle_scope") @db.VarChar(8)
  unitPriceMinor BigInt    @map("unit_price_minor")
  book           PriceBook @relation(fields: [revision], references: [revision], onDelete: Restrict, onUpdate: Restrict)

  @@id([revision, definitionId, vehicleScope])
  @@map("price_book_entry")
}

/// Immutable server-issued pricing.v1 quote, owned by its beneficiary principal.
model PricingQuote {
  id                 String             @id @db.Uuid
  revision           Int
  beneficiaryKind    String             @map("beneficiary_kind") @db.VarChar(8)
  beneficiarySubject String             @map("beneficiary_subject") @db.Uuid
  requestedBy        String             @map("requested_by") @db.Uuid
  vehicleType        String             @map("vehicle_type") @db.VarChar(8)
  zoneId             String?            @map("zone_id") @db.Uuid
  currency           String             @db.Char(3)
  scale              Int                @db.SmallInt
  priceBookRevision  Int                @map("price_book_revision")
  catalogRevision    Int                @map("catalog_revision")
  policyRevision     String             @map("policy_revision") @db.VarChar(64)
  totalMinor         BigInt             @map("total_minor")
  issuedAt           DateTime           @map("issued_at") @db.Timestamptz(3)
  expiresAt          DateTime           @map("expires_at") @db.Timestamptz(3)
  correlationId      String             @map("correlation_id") @db.Uuid
  book               PriceBook          @relation(fields: [priceBookRevision], references: [revision], onDelete: Restrict, onUpdate: Restrict)
  lines              PricingQuoteLine[]

  @@index([beneficiarySubject, issuedAt], map: "pricing_quote_beneficiary_issued_idx")
  @@map("pricing_quote")
}

model PricingQuoteLine {
  quoteId        String       @map("quote_id") @db.Uuid
  lineNo         Int          @map("line_no") @db.SmallInt
  lineId         String       @unique @map("line_id") @db.Uuid
  kind           String       @db.VarChar(18)
  definitionId   String       @map("definition_id") @db.Uuid
  quantity       Int          @db.SmallInt
  unitPriceMinor BigInt       @map("unit_price_minor")
  amountMinor    BigInt       @map("amount_minor")
  quote          PricingQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([quoteId, lineNo])
  @@map("pricing_quote_line")
}

/// Append-only audit of price book publication and service quote validation.
model PricingAuditRecord {
  id            String   @id @db.Uuid
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(3)
  actor         String   @db.VarChar(80)
  action        String   @db.VarChar(64)
  subjectRef    String?  @map("subject_ref") @db.VarChar(80)
  purpose       String?  @db.VarChar(32)
  outcome       String   @db.VarChar(64)
  correlationId String   @map("correlation_id") @db.Uuid

  @@index([occurredAt], map: "pricing_audit_record_occurred_idx")
  @@map("pricing_audit_record")
}

// ---------------------------------------------------------------------------
// P05-B2. Promotions with immutable revisions, the quote discount component,
// redemption reservations with caps, promotion audit and the outbox. CHECK
// constraints, guards and COMMIT-time caps live in the migration.

model Promotion {
  code         String              @id
  couponDigest String              @unique(map: "promotion_coupon_digest_key") @map("coupon_digest") @db.Char(64)
  createdAt    DateTime            @map("created_at") @db.Timestamptz(3)
  createdBy    String              @map("created_by") @db.Uuid
  revisions    PromotionRevision[]

  @@map("promotion")
}

model PromotionRevision {
  promotionCode    String                @map("promotion_code")
  revision         Int
  effectiveFrom    DateTime              @map("effective_from") @db.Timestamptz(3)
  publishedAt      DateTime              @map("published_at") @db.Timestamptz(3)
  publishedBy      String                @map("published_by") @db.Uuid
  correlationId    String                @map("correlation_id") @db.Uuid
  discountKind     String                @map("discount_kind")
  basisPoints      Int?                  @map("basis_points")
  maxDiscountMinor BigInt?               @map("max_discount_minor")
  fixedAmountMinor BigInt?               @map("fixed_amount_minor")
  currency         String                @db.Char(3)
  packageIds       String[]              @map("package_ids")
  minSubtotalMinor BigInt                @map("min_subtotal_minor")
  endsAt           DateTime?             @map("ends_at") @db.Timestamptz(3)
  totalCap         Int                   @map("total_cap")
  perCustomerCap   Int                   @map("per_customer_cap")
  active           Boolean
  promotion        Promotion             @relation(fields: [promotionCode], references: [code], onDelete: Restrict, onUpdate: Restrict, map: "promotion_revision_promotion_fkey")
  discounts        QuoteDiscount[]
  redemptions      PromotionRedemption[]

  @@id([promotionCode, revision], map: "promotion_revision_pkey")
  @@unique([promotionCode, effectiveFrom], map: "promotion_revision_effective_key")
  @@map("promotion_revision")
}

model QuoteDiscount {
  quoteId           String                @id(map: "quote_discount_pkey") @map("quote_id") @db.Uuid
  promotionCode     String                @map("promotion_code")
  promotionRevision Int                   @map("promotion_revision")
  amountMinor       BigInt                @map("amount_minor")
  quote             Quote                 @relation(fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "quote_discount_quote_fkey")
  revision          PromotionRevision     @relation(fields: [promotionCode, promotionRevision], references: [promotionCode, revision], onDelete: Restrict, onUpdate: Restrict, map: "quote_discount_revision_fkey")
  redemption        PromotionRedemption?

  @@map("quote_discount")
}

model PromotionRedemption {
  id              String            @id @db.Uuid
  promotionCode   String            @map("promotion_code")
  capsRevision    Int               @map("caps_revision")
  quoteId         String            @unique(map: "promotion_redemption_quote_key") @map("quote_id") @db.Uuid
  bookingId       String            @map("booking_id") @db.Uuid
  customerSubject String            @map("customer_subject") @db.Uuid
  discountMinor   BigInt            @map("discount_minor")
  currency        String            @db.Char(3)
  status          String
  version         Int
  reservedAt      DateTime          @map("reserved_at") @db.Timestamptz(3)
  reservedBy      String            @map("reserved_by")
  settledAt       DateTime?         @map("settled_at") @db.Timestamptz(3)
  settledBy       String?           @map("settled_by")
  reason          String?
  correlationId   String            @map("correlation_id") @db.Uuid
  liveSlot        Int?              @map("live_slot") @db.SmallInt
  revision        PromotionRevision @relation(fields: [promotionCode, capsRevision], references: [promotionCode, revision], onDelete: Restrict, onUpdate: Restrict, map: "promotion_redemption_revision_fkey")
  discount        QuoteDiscount     @relation(fields: [quoteId], references: [quoteId], onDelete: Restrict, onUpdate: Restrict, map: "promotion_redemption_quote_fkey")

  @@unique([promotionCode, bookingId], map: "promotion_redemption_booking_key")
  @@unique([bookingId, liveSlot], map: "promotion_redemption_live_booking_key")
  @@index([promotionCode, customerSubject, liveSlot], map: "promotion_redemption_live_idx")
  @@map("promotion_redemption")
}

model PromotionAuditEvent {
  id            String   @id @db.Uuid
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(3)
  actorKind     String   @map("actor_kind")
  actorId       String   @map("actor_id")
  action        String
  promotionCode String   @map("promotion_code")
  redemptionId  String?  @map("redemption_id") @db.Uuid
  outcome       String
  correlationId String   @map("correlation_id") @db.Uuid

  @@index([promotionCode, occurredAt], map: "promotion_audit_event_promotion_idx")
  @@map("promotion_audit_event")
}

model OutboxMessage {
  id            String    @id @db.Uuid
  eventId       String    @unique @map("event_id") @db.Uuid
  eventType     String    @map("event_type")
  exchange      String
  routingKey    String    @map("routing_key")
  payload       String
  correlationId String    @map("correlation_id") @db.Uuid
  traceParent   String?   @map("trace_parent") @db.VarChar(55)
  attempts      Int       @default(0)
  lockedBy      String?   @map("locked_by")
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(3)
  lastError     String?   @map("last_error")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  deadAt        DateTime? @map("dead_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([publishedAt, deadAt, createdAt], map: "outbox_message_pending_idx")
  @@map("outbox_message")
}
