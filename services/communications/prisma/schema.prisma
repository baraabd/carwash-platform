// communications owns this schema.
//
// Generated by scripts/dev/generate-service-schemas.mjs and then committed.
// No other service may read, write or import these tables, and this file must
// never describe another service's data. There is no shared business schema.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// The connection URL lives in prisma.config.ts / the environment, never here, so
// the migration identity and the runtime identity stay genuinely separate.
datasource db {
  provider = "postgresql"
}

/// Written by the migration job so a test can prove migrations really ran
/// against this database rather than assuming they did.
model ServiceMarker {
  service   String   @id
  schemaRev Int      @map("schema_rev")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("service_marker")
}

/// Consumer inbox. The primary key is the producer's eventId, so a redelivery
/// collides instead of producing a second local effect. payload_hash lets the
/// consumer detect the same eventId arriving with different bytes, which is an
/// integrity fault and not a retry case.
model InboxMessage {
  eventId       String   @id @map("event_id") @db.Uuid
  eventType     String   @map("event_type")
  payloadHash   String   @map("payload_hash")
  correlationId String   @map("correlation_id") @db.Uuid
  receivedAt    DateTime @default(now()) @map("received_at")

  @@map("inbox_message")
}

/// Local effect of the probe slice. applyCount MUST stay at 1 for a given probe
/// no matter how often the broker redelivers the event: it is the observable
/// that makes duplicate side effects detectable instead of invisible.
model ProbeNotification {
  probeId    String   @id @map("probe_id") @db.Uuid
  label      String   @db.VarChar(40)
  applyCount Int      @default(1) @map("apply_count")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("probe_notification")
}

/// P01-D notification intent and its delivery state. One row per logical
/// notification. (source_service, idempotency_key) is the business identity:
/// a replay with the same request fingerprint returns the original intent, a
/// different fingerprint is a conflict. fence increases on every claim so a
/// worker whose lease expired can never overwrite a newer attempt's result.
model Notification {
  id                String    @id @db.Uuid
  sourceService     String    @map("source_service") @db.VarChar(32)
  idempotencyKey    String    @map("idempotency_key") @db.VarChar(128)
  requestHash       String    @map("request_hash") @db.Char(64)
  recipientRef      String    @map("recipient_ref") @db.Uuid
  channel           String    @db.VarChar(8)
  templateKey       String    @map("template_key") @db.VarChar(64)
  templateVersion   Int       @map("template_version")
  parameters        Json
  state             String    @db.VarChar(20)
  attemptCount      Int       @default(0) @map("attempt_count")
  fence             Int       @default(0)
  nextAttemptAt     DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  leaseOwner        String?   @map("lease_owner") @db.VarChar(64)
  leaseUntil        DateTime? @map("lease_until") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  providerMessageId String?   @map("provider_message_id") @db.VarChar(128)
  lastErrorCode     String?   @map("last_error_code") @db.VarChar(64)
  /// P03-D: opaque owner reference this notification is about (for example a
  /// booking). Both set or both null; never the source of truth for it.
  subjectType       String?   @map("subject_type") @db.VarChar(32)
  subjectRef        String?   @map("subject_ref") @db.Uuid
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(3)

  attempts DeliveryAttempt[]

  @@unique([sourceService, idempotencyKey])
  @@index([state, nextAttemptAt])
  @@index([subjectType, subjectRef])
  @@index([createdAt, id])
  @@map("notification")
}

/// One row per submission attempt. (notification_id, attempt_no) is unique, and
/// fence records which claim made the attempt, so an attempt's outcome can be
/// attributed to exactly one worker lease.
model DeliveryAttempt {
  notificationId    String       @map("notification_id") @db.Uuid
  attemptNo         Int          @map("attempt_no")
  fence             Int
  workerId          String       @map("worker_id") @db.VarChar(64)
  startedAt         DateTime     @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime?    @map("finished_at") @db.Timestamptz(3)
  outcome           String?      @db.VarChar(24)
  providerMessageId String?      @map("provider_message_id") @db.VarChar(128)
  errorCode         String?      @map("error_code") @db.VarChar(64)
  notification      Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict)

  @@id([notificationId, attemptNo])
  @@map("delivery_attempt")
}
