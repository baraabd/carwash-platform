// wallet owns this schema.
//
// Generated by scripts/dev/generate-service-schemas.mjs and then committed.
// No other service may read, write or import these tables, and this file must
// never describe another service's data. There is no shared business schema.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// The connection URL lives in prisma.config.ts / the environment, never here, so
// the migration identity and the runtime identity stay genuinely separate.
datasource db {
  provider = "postgresql"
}

/// Written by the migration job so a test can prove migrations really ran
/// against this database rather than assuming they did.
model ServiceMarker {
  service   String   @id
  schemaRev Int      @map("schema_rev")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("service_marker")
}

// ---------------------------------------------------------------------------
// P06-B3 technician cash-custody READ PROJECTION (migration
// 20261011100000_p06b3_wallet_custody_projection). Folded from published
// billing.v1 events; Billing's ledger remains the only financial ledger. CHECK
// constraints and append-only/forward-only triggers live in the migration.

model WalletInbox {
  eventId          String                  @id @map("event_id") @db.Uuid
  eventType        String                  @map("event_type") @db.VarChar(96)
  payloadHash      String                  @map("payload_hash") @db.Char(64)
  outcome          String                  @db.VarChar(8)
  reason           String?                 @db.VarChar(64)
  aggregateType    String?                 @map("aggregate_type") @db.VarChar(48)
  aggregateId      String?                 @map("aggregate_id") @db.Uuid
  aggregateVersion Int?                    @map("aggregate_version")
  correlationId    String?                 @map("correlation_id") @db.Uuid
  occurredAt       DateTime?               @map("occurred_at") @db.Timestamptz(3)
  receivedAt       DateTime                @map("received_at") @db.Timestamptz(3)
  conflicts        WalletInboxConflict[]
  collectedOf      WalletCustodyReceipt[]  @relation("ReceiptCollectedEvent")
  reversedOf       WalletCustodyReceipt[]  @relation("ReceiptReversedEvent")
  handovers        WalletCustodyHandover[]
  movements        WalletMovement[]        @relation("MovementEvent")
  appliedMovements WalletMovement[]        @relation("MovementAppliedWith")

  @@index([aggregateId, aggregateVersion], map: "wallet_inbox_aggregate_idx")
  @@index([outcome, receivedAt], map: "wallet_inbox_outcome_idx")
  @@map("wallet_inbox")
}

model WalletInboxConflict {
  id          BigInt      @id @default(autoincrement())
  eventId     String      @map("event_id") @db.Uuid
  payloadHash String      @map("payload_hash") @db.Char(64)
  detectedAt  DateTime    @map("detected_at") @db.Timestamptz(3)
  inbox       WalletInbox @relation(fields: [eventId], references: [eventId], onDelete: Restrict, onUpdate: Restrict)

  @@index([eventId])
  @@map("wallet_inbox_conflict")
}

model WalletCustodyReceipt {
  receiptId        String       @id @map("receipt_id") @db.Uuid
  holderSubject    String?      @map("holder_subject") @db.Uuid
  currency         String       @db.Char(3)
  amountMinor      BigInt       @map("amount_minor")
  collectedEventId String?      @map("collected_event_id") @db.Uuid
  reversedEventId  String?      @map("reversed_event_id") @db.Uuid
  version          Int
  createdAt        DateTime     @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @map("updated_at") @db.Timestamptz(3)
  collectedEvent   WalletInbox? @relation("ReceiptCollectedEvent", fields: [collectedEventId], references: [eventId], onDelete: Restrict, onUpdate: Restrict)
  reversedEvent    WalletInbox? @relation("ReceiptReversedEvent", fields: [reversedEventId], references: [eventId], onDelete: Restrict, onUpdate: Restrict)

  @@index([holderSubject, currency], map: "wallet_custody_receipt_holder_idx")
  @@map("wallet_custody_receipt")
}

model WalletCustodyHandover {
  handoverId    String      @id @map("handover_id") @db.Uuid
  holderSubject String      @map("holder_subject") @db.Uuid
  currency      String      @db.Char(3)
  status        String      @db.VarChar(12)
  receiptCount  Int         @map("receipt_count")
  declaredMinor BigInt      @map("declared_minor")
  countedMinor  BigInt?     @map("counted_minor")
  shortageMinor BigInt?     @map("shortage_minor")
  overageMinor  BigInt?     @map("overage_minor")
  version       Int
  lastEventId   String      @map("last_event_id") @db.Uuid
  createdAt     DateTime    @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @map("updated_at") @db.Timestamptz(3)
  lastEvent     WalletInbox @relation(fields: [lastEventId], references: [eventId], onDelete: Restrict, onUpdate: Restrict)

  @@index([holderSubject, currency, status], map: "wallet_custody_handover_holder_idx")
  @@map("wallet_custody_handover")
}

model WalletAccount {
  id              String           @id @db.Uuid
  holderSubject   String           @map("holder_subject") @db.Uuid
  currency        String           @db.Char(3)
  purpose         String           @db.VarChar(24)
  collectedMinor  BigInt           @map("collected_minor")
  reversedMinor   BigInt           @map("reversed_minor")
  inHandoverMinor BigInt           @map("in_handover_minor")
  receivedMinor   BigInt           @map("received_minor")
  settledMinor    BigInt           @map("settled_minor")
  shortageMinor   BigInt           @map("shortage_minor")
  overageMinor    BigInt           @map("overage_minor")
  revision        Int
  lastEventId     String?          @map("last_event_id") @db.Uuid
  lastEventAt     DateTime?        @map("last_event_at") @db.Timestamptz(3)
  createdAt       DateTime         @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @map("updated_at") @db.Timestamptz(3)
  movements       WalletMovement[]

  @@unique([holderSubject, currency, purpose])
  @@map("wallet_accounts")
}

model WalletMovement {
  id                 String        @id @db.Uuid
  accountId          String        @map("account_id") @db.Uuid
  eventId            String        @map("event_id") @db.Uuid
  appliedWithEventId String        @map("applied_with_event_id") @db.Uuid
  kind               String        @db.VarChar(24)
  currency           String        @db.Char(3)
  amountMinor        BigInt        @map("amount_minor")
  sourceType         String        @map("source_type") @db.VarChar(48)
  sourceId           String        @map("source_id") @db.Uuid
  accountRevision    Int           @map("account_revision")
  recordedAt         DateTime      @map("recorded_at") @db.Timestamptz(3)
  account            WalletAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  event              WalletInbox   @relation("MovementEvent", fields: [eventId], references: [eventId], onDelete: Restrict, onUpdate: Restrict)
  appliedWith        WalletInbox   @relation("MovementAppliedWith", fields: [appliedWithEventId], references: [eventId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([eventId, accountId])
  @@index([accountId, recordedAt], map: "wallet_movements_account_idx")
  @@map("wallet_movements")
}
