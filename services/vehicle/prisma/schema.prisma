// vehicle owns this schema.
//
// Generated by scripts/dev/generate-service-schemas.mjs and then committed.
// No other service may read, write or import these tables, and this file must
// never describe another service's data. There is no shared business schema.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// The connection URL lives in prisma.config.ts / the environment, never here, so
// the migration identity and the runtime identity stay genuinely separate.
datasource db {
  provider = "postgresql"
}

/// Written by the migration job so a test can prove migrations really ran
/// against this database rather than assuming they did.
model ServiceMarker {
  service   String   @id
  schemaRev Int      @map("schema_rev")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("service_marker")
}

/// A saved vehicle (vehicle.v1). The owner is the authenticated principal (kind +
/// Identity subject); there is no owner-transfer field. Plates are descriptive
/// and are deliberately NOT unique, globally or per owner. The P01 column
/// display_name holds the vehicle.v1 nickname (no rename: expand-only).
model Vehicle {
  id           String    @id @db.Uuid
  ownerKind    String    @map("owner_kind") @db.VarChar(16)
  ownerSubject String    @map("owner_subject") @db.Uuid
  vehicleType  String    @map("vehicle_type") @db.VarChar(16)
  nickname     String?   @map("display_name") @db.VarChar(60)
  make         String?   @db.VarChar(40)
  model        String?   @db.VarChar(40)
  plate        String?   @db.VarChar(20)
  plateRegion  String?   @map("plate_region") @db.VarChar(30)
  color        String?   @db.VarChar(40)
  status       String    @db.VarChar(16)
  revision     Int
  createdAt    DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @map("updated_at") @db.Timestamptz(3)
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(3)

  @@index([ownerKind, ownerSubject, status], map: "vehicle_owner_status_idx")
  @@index([ownerKind, ownerSubject, status, createdAt, id], map: "vehicle_owner_page_idx")
  @@map("vehicle")
}

/// Idempotency records live and die with the write they protect.
model IdempotencyRecord {
  scope          String   @db.VarChar(80)
  key            String   @db.VarChar(128)
  operation      String   @db.VarChar(40)
  fingerprint    String   @db.Char(64)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([scope, key], map: "idempotency_record_pkey")
  @@index([expiresAt], map: "idempotency_record_expiry_idx")
  @@map("idempotency_record")
}

/// Transactional outbox. Rows are written with the state change they describe.
model OutboxMessage {
  id            String    @id @db.Uuid
  eventId       String    @unique(map: "outbox_message_event_id_key") @map("event_id") @db.Uuid
  eventType     String    @map("event_type")
  exchange      String
  routingKey    String    @map("routing_key")
  payload       String
  correlationId String    @map("correlation_id") @db.Uuid
  traceParent   String?   @map("trace_parent") @db.VarChar(55)
  attempts      Int       @default(0)
  lockedBy      String?   @map("locked_by")
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(3)
  lastError     String?   @map("last_error")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  deadAt        DateTime? @map("dead_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([publishedAt, deadAt, createdAt], map: "outbox_message_pending_idx")
  @@map("outbox_message")
}

/// Append-only audit facts for vehicle mutations and service snapshot reads.
/// Identifiers only. A principal action has subject + session; a service read
/// has the calling service and its declared purpose.
model AuditEntry {
  id             String   @id @db.Uuid
  actorKind      String   @default("principal") @map("actor_kind") @db.VarChar(16)
  actorSubject   String?  @map("actor_subject") @db.Uuid
  actorSessionId String?  @map("actor_session_id") @db.Uuid
  actorService   String?  @map("actor_service") @db.VarChar(60)
  purpose        String?  @db.VarChar(40)
  action         String   @db.VarChar(60)
  vehicleId      String   @map("vehicle_id") @db.Uuid
  correlationId  String   @map("correlation_id") @db.Uuid
  at             DateTime @db.Timestamptz(3)

  @@index([vehicleId, at], map: "audit_entry_vehicle_idx")
  @@map("audit_entry")
}