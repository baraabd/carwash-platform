# Sprint 0.2 toolchain policy.
# engine-strict: refuse to install under a Node major the workspace does not declare.
engine-strict=true
# package-manager-strict: refuse to run under a pnpm version other than the pinned one.
package-manager-strict=true
# Lifecycle scripts stay blocked by default; allowed packages are listed in
# pnpm-workspace.yaml (onlyBuiltDependencies) after the script has been reviewed.
# Deterministic, isolated node_modules. Never switch to a non-official registry.
registry=https://registry.npmjs.org/
