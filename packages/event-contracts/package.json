{
  "name": "@carwash/event-contracts",
  "version": "0.2.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./booking-confirmed": {
      "types": "./dist/booking-confirmed.d.ts",
      "default": "./dist/booking-confirmed.js"
    },
    "./booking-confirmed-v1": {
      "types": "./dist/booking-confirmed.d.ts",
      "default": "./dist/booking-confirmed.js"
    },
    "./foundation-probe-created-v1": {
      "types": "./dist/foundation-probe-created.d.ts",
      "default": "./dist/foundation-probe-created.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./envelope-v2": {
      "types": "./dist/envelope-v2.d.ts",
      "default": "./dist/envelope-v2.js"
    },
    "./business-v1": {
      "types": "./dist/business-v1.d.ts",
      "default": "./dist/business-v1.js"
    },
    "./booking-billing-v1": {
      "types": "./dist/booking-billing-v1.d.ts",
      "default": "./dist/booking-billing-v1.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "5.9.3"
  }
}
