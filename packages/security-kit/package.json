{
  "name": "@carwash/security-kit",
  "version": "0.0.2",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.13.6"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server-proxy": "./server-proxy.mjs",
    "./service-origin": {
      "types": "./dist/service-origin.d.ts",
      "default": "./dist/service-origin.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "server-proxy.mjs"
  ],
  "dependencies": {
    "@redis/client": "6.1.0",
    "jose": "6.2.5",
    "@carwash/contracts": "workspace:*"
  }
}
