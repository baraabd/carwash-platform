# Migration job image, one per database owner (P07-E1).
#
# A release ships TWO artifacts per database owner: the runtime image built from
# services/<id>/Dockerfile, and this one-shot migration job. They are separate on
# purpose:
#   - the runtime image carries no Prisma CLI and no schema engine, so a replica
#     cannot migrate even if it is handed the wrong credentials,
#   - this image carries no application code, only the owner's committed
#     migrations, its schema and the pinned Prisma CLI, and it refuses to start
#     with anything but that owner's migration identity (migrate-job.mjs).
#
# Build from the repository root:
#   docker buildx build -f infra/release/Dockerfile.migrate \
#     --build-arg SERVICE=booking --build-arg NODE_IMAGE=node@sha256:... .
#
# Keep build tooling out of the job. Prisma's schema engine needs OpenSSL 3;
# copy only its Debian 13 ABI libraries and original package inventory from the
# pinned donor, rather than shipping Bookworm's shell, apt, PAM, Perl and dpkg.
ARG NODE_IMAGE=node:24.21.0-bookworm-slim
ARG MIGRATION_RUNTIME_IMAGE=gcr.io/distroless/base-nossl-debian13@sha256:89815d620ac01d8de13cdaf04d19ed874447ca2296d4985b14b818f6e5e47854
ARG MIGRATION_NATIVE_IMAGE=gcr.io/distroless/cc-debian13@sha256:cb87acc574abe719b6e5c547384defa2f7b1f24af9605d3f618cf852495d8be2

# ---------------------------------------------------------------- builder ----
FROM ${NODE_IMAGE} AS builder
ENV CI=true
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc tsconfig.base.json ./
COPY packages ./packages
COPY services ./services

RUN corepack enable && corepack prepare --activate
# --frozen-lockfile: the job runs exactly the Prisma CLI the lockfile resolves.
RUN pnpm install --frozen-lockfile

# Declared only now so the install layer above is shared by every owner's job.
ARG SERVICE
RUN test -n "${SERVICE}" \
 && test -f "services/${SERVICE}/prisma/schema.prisma" \
 && test -d "services/${SERVICE}/prisma/migrations"

# The owner's own dependency tree, INCLUDING devDependencies, because the Prisma
# CLI is a devDependency of every service. Only node_modules and the owner's
# prisma directory are copied into the job below; no application source is.
RUN pnpm --filter "@carwash/${SERVICE}" deploy --legacy /deploy

# ------------------------------------------------------------------- job ----
FROM ${MIGRATION_NATIVE_IMAGE} AS native_libraries

FROM ${MIGRATION_RUNTIME_IMAGE} AS job
ARG SERVICE

COPY --from=builder /usr/local/bin/node /usr/local/bin/node
COPY --from=native_libraries /usr/lib/x86_64-linux-gnu/libstdc++.so.6 /usr/lib/x86_64-linux-gnu/libstdc++.so.6
COPY --from=native_libraries /usr/lib/x86_64-linux-gnu/libgcc_s.so.1 /usr/lib/x86_64-linux-gnu/libgcc_s.so.1
COPY --from=native_libraries /usr/lib/x86_64-linux-gnu/libssl.so.3 /usr/lib/x86_64-linux-gnu/libssl.so.3
COPY --from=native_libraries /usr/lib/x86_64-linux-gnu/libcrypto.so.3 /usr/lib/x86_64-linux-gnu/libcrypto.so.3
COPY --from=native_libraries /usr/lib/x86_64-linux-gnu/libz.so.1 /usr/lib/x86_64-linux-gnu/libz.so.1
COPY --from=native_libraries /usr/lib/x86_64-linux-gnu/libzstd.so.1 /usr/lib/x86_64-linux-gnu/libzstd.so.1
COPY --from=native_libraries /var/lib/dpkg/status.d/libstdc++6* /var/lib/dpkg/status.d/
COPY --from=native_libraries /var/lib/dpkg/status.d/libgcc-s1* /var/lib/dpkg/status.d/
COPY --from=native_libraries /var/lib/dpkg/status.d/libssl3t64* /var/lib/dpkg/status.d/
COPY --from=native_libraries /var/lib/dpkg/status.d/zlib1g* /var/lib/dpkg/status.d/
COPY --from=native_libraries /var/lib/dpkg/status.d/libzstd1* /var/lib/dpkg/status.d/
COPY --from=native_libraries /usr/share/doc/libstdc++6 /usr/share/doc/libstdc++6
COPY --from=native_libraries /usr/share/doc/libgcc-s1 /usr/share/doc/libgcc-s1
COPY --from=native_libraries /usr/share/doc/libssl3t64 /usr/share/doc/libssl3t64
COPY --from=native_libraries /usr/share/doc/zlib1g /usr/share/doc/zlib1g
COPY --from=native_libraries /usr/share/doc/libzstd1 /usr/share/doc/libzstd1

# Physical removal, preserving original libc inventory/checksums/licenses.
# The migration scanner proves this again in the final immutable job image and
# executes the actual Prisma schema engine before assessing these exact CVEs.
USER 0
RUN ["/usr/local/bin/node","-e","const fs=require('node:fs');for(const name of [\"UHC.so\",\"ISO-2022-CN-EXT.so\",\"IBM1390.so\",\"IBM1399.so\"]){const file='/usr/lib/x86_64-linux-gnu/gconv/'+name;if(!fs.lstatSync(file).isFile())throw Error('UNEXPECTED_CONVERTER_FILE');fs.unlinkSync(file);}"]

ENV NODE_ENV=production
ENV CW_SERVICE=${SERVICE}
WORKDIR /migrate

COPY --from=builder --chown=0:0 /deploy/node_modules ./node_modules
COPY --from=builder --chown=0:0 /deploy/package.json ./package.json
COPY --from=builder --chown=0:0 /deploy/prisma.config.ts ./prisma.config.ts
COPY --from=builder --chown=0:0 /deploy/prisma ./prisma
COPY --chown=0:0 infra/release/migrate-job.mjs ./migrate-job.mjs

# Files are root-owned and read-only to the job identity: the job can read its
# migrations but cannot rewrite them at run time.
USER 1000:1000
ENTRYPOINT ["node", "/migrate/migrate-job.mjs"]
CMD ["deploy"]
