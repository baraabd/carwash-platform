# Migration job image, one per database owner (P07-E1).
#
# A release ships TWO artifacts per database owner: the runtime image built from
# services/<id>/Dockerfile, and this one-shot migration job. They are separate on
# purpose:
#   - the runtime image carries no Prisma CLI and no schema engine, so a replica
#     cannot migrate even if it is handed the wrong credentials,
#   - this image carries no application code, only the owner's committed
#     migrations, its schema and the pinned Prisma CLI, and it refuses to start
#     with anything but that owner's migration identity (migrate-job.mjs).
#
# Build from the repository root:
#   docker buildx build -f infra/release/Dockerfile.migrate \
#     --build-arg SERVICE=booking --build-arg NODE_IMAGE=node@sha256:... .
#
# The job uses supported Bookworm OpenSSL 3.0, which is unaffected by the
# observed OpenSSL 3.5 QUIC findings. Its libraries and CA data come only from
# checksum-pinned Debian packages. A native closure proof rejects any builder
# library fallback. Original package records, checksums and licences remain.
ARG NODE_IMAGE=docker.io/library/node@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20

# ---------------------------------------------------------------- builder ----
FROM ${NODE_IMAGE} AS builder
ARG NODE_IMAGE
ENV CI=true
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# The build image has no system OpenSSL. The pinned @prisma/engines 7.10
# installer otherwise guesses 1.1, while the final job intentionally uses 3.0.
# Select the final ABI at download time; never fetch an engine at job runtime.
ENV PRISMA_CLI_BINARY_TARGETS=debian-openssl-3.0.x
WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc tsconfig.base.json ./
COPY packages ./packages
COPY services ./services

RUN corepack enable && corepack prepare --activate
# --frozen-lockfile: the job runs exactly the Prisma CLI the lockfile resolves.
RUN pnpm install --frozen-lockfile

# Declared only now so the install layer above is shared by every owner's job.
ARG SERVICE
RUN test -n "${SERVICE}" \
 && test -f "services/${SERVICE}/prisma/schema.prisma" \
 && test -d "services/${SERVICE}/prisma/migrations"

# The owner's own dependency tree, INCLUDING devDependencies, because the Prisma
# CLI is a devDependency of every service. Only node_modules and the owner's
# prisma directory are copied into the job below; no application source is.
RUN pnpm --filter "@carwash/${SERVICE}" deploy --legacy /deploy
# Fail the build if Prisma's optional postinstall download failed or deploy
# omitted the final-platform engine. Its real ABI execution is proved below.
RUN node -e "const fs=require('node:fs');const path=require('node:path');const {createRequire}=require('node:module');const owner=createRequire('/deploy/package.json');if(owner('prisma/package.json').version!=='7.10.0')throw Error('UNEXPECTED_PRISMA_VERSION');const prisma=createRequire(owner.resolve('prisma/package.json'));const engines=prisma('@prisma/engines');fs.accessSync(path.join(engines.getEnginesPath(),'schema-engine-debian-openssl-3.0.x'),fs.constants.R_OK|fs.constants.X_OK);"

COPY scripts/production/E/release/migration-rootfs.mjs scripts/production/E/release/migration-runtime.lock.json ./scripts/production/E/release/
RUN node scripts/production/E/release/migration-rootfs.mjs \
    --root /migration-rootfs --deploy /deploy \
    --lock scripts/production/E/release/migration-runtime.lock.json \
    --node-image "${NODE_IMAGE}"

# ------------------------------------------------------------------- job ----
FROM scratch AS job
ARG SERVICE
COPY --from=builder --chown=0:0 /migration-rootfs/ /

ENV NODE_ENV=production
ENV PATH=/usr/local/bin
ENV LANG=C.UTF-8
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV SSL_CERT_DIR=/etc/ssl/certs
ENV CW_SERVICE=${SERVICE}
WORKDIR /migrate

COPY --from=builder --chown=0:0 /deploy/node_modules ./node_modules
COPY --from=builder --chown=0:0 /deploy/package.json ./package.json
COPY --from=builder --chown=0:0 /deploy/prisma.config.ts ./prisma.config.ts
COPY --from=builder --chown=0:0 /deploy/prisma ./prisma
COPY --chown=0:0 infra/release/migrate-job.mjs ./migrate-job.mjs

# Root-owned inputs remain read-only to the one-shot migration identity.
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/node", "/migrate/migrate-job.mjs"]
CMD ["deploy"]
