# Context for: docker buildx build -f infra/release/Dockerfile.migrate .
# Dockerfile-specific rules replace the root .dockerignore. Only the workspace
# manifests, shared packages, services and the job entry point are needed.
infra/*
!infra/release
infra/release/*
!infra/release/migrate-job.mjs
apps
**/node_modules
**/dist
**/dist-tests
**/src/generated
.git
.github
.acceptance
evidence
design
docs
tests
scripts
security
*.md
.env
.env.*
